# Copy this file to .env for local development
# API Configuration
# For development: use relative path with proxy
# For production: use full backend URL (e.g., https://your-api.com/api)
VITE_API_BASE_URL=/api

# Backend Server URL (used by Vite proxy in development)
VITE_BACKEND_URL=http://localhost:3000

# Environment
VITE_NODE_ENV=development
