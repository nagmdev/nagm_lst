# Copy to .env for local development. Values here are examples, not secrets:
# never put passwords or API keys in this file - it is committed.

# Base URL of the Nagm API, including /api. Unset, the site uses the
# production API (https://backend-yqpd.vercel.app/api). For a local backend:
VITE_BACKEND_API=http://localhost:3000/api

NODE_ENV=production
